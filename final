/* TOURNAMENT ANALYSIS */

void TournamentAnalysis()
{
    int valorant = 0;
    int pubg = 0;
    int mobileLegends = 0;
    int eaFC = 0;


    // Count registrations according to tournament's game
    for (int i = 0; i < registrationCount; i++)
    {
        // Only count active registrations
        if (registrations[i].status == "Cancelled")
        {
            continue;
        }


        string tournamentID = registrations[i].tournamentID;


        // Find tournament
        for (int j = 0; j < tournamentCount; j++)
        {
            if (tournamentIDs[j] == tournamentID)
            {
                if (gameNames[j] == "Valorant")
                {
                    valorant++;
                }
                else if (gameNames[j] == "PUBG")
                {
                    pubg++;
                }
                else if (gameNames[j] == "Mobile Legends")
                {
                    mobileLegends++;
                }
                else if (gameNames[j] == "EA FC")
                {
                    eaFC++;
                }


                break;
            }
        }
    }


    string mostPopular;
    int highest = valorant;


    mostPopular = "Valorant";


    if (pubg > highest)
    {
        highest = pubg;
        mostPopular = "PUBG";
    }


    if (mobileLegends > highest)
    {
        highest = mobileLegends;
        mostPopular = "Mobile Legends";
    }


    if (eaFC > highest)
    {
        highest = eaFC;
        mostPopular = "EA FC";
    }


    cout << "\n========================================" << endl;
    cout << "           TOURNAMENT ANALYSIS" << endl;
    cout << "========================================" << endl;


    cout << "Valorant       : " << valorant << " registrations" << endl;
    cout << "PUBG           : " << pubg << " registrations" << endl;
    cout << "Mobile Legends : " << mobileLegends << " registrations" << endl;
    cout << "EA FC          : " << eaFC << " registrations" << endl;


    cout << "----------------------------------------" << endl;

    if (registrationCount == 0)
    {
        cout << "Most Popular Tournament : No registrations" << endl;
        cout << "Number of Registrations : 0" << endl;
    }
    else
    {
        cout << "Most Popular Tournament : "
            << mostPopular << endl;

        cout << "Number of Registrations : "
            << highest << endl;
    }


    cout << "========================================" << endl;
}


/* SORT REGISTRATIONS */

void SortRegistrations()
{
    if (registrationCount == 0)
    {
        cout << "\nNo registrations available to sort.\n";
        return;
    }


    // Make a temporary array so that
    // original registration records are not changed.
    string sortedRegistrationIDs[100];


    for (int i = 0; i < registrationCount; i++)
    {
        sortedRegistrationIDs[i] = registrations[i].regID;
    }


    // Bubble sort
    for (int i = 0; i < registrationCount - 1; i++)
    {
        for (int j = 0;
            j < registrationCount - i - 1;
            j++)
        {
            if (sortedRegistrationIDs[j] >
                sortedRegistrationIDs[j + 1])
            {
                string temp = sortedRegistrationIDs[j];

                sortedRegistrationIDs[j] =
                    sortedRegistrationIDs[j + 1];

                sortedRegistrationIDs[j + 1] =
                    temp;
            }
        }
    }


    cout << endl
        << setfill('=') << setw(40) << left << " "
        << "\n       SORTED REGISTRATIONS\n"
        << setw(40) << left << " ";


    for (int i = 0; i < registrationCount; i++)
    {
        cout << endl
            << i + 1 << ". "
            << sortedRegistrationIDs[i];
    }


    cout << endl
        << setfill('=') << setw(40) << left << " ";
}
