/* ADD TOURNAMENT */

void add()
{
    string tournamentID;
    bool duplicate;


    cout << "\n-------- Add Tournament ---------" << endl;


    // Tournament ID
    while (true)
    {
        cout << "Please enter tournament ID (e.g., T001): ";
        cin >> tournamentID;


        if (tournamentID.empty())
        {
            cout << "Tournament ID cannot be empty!" << endl;
            continue;
        }


        duplicate = false;

        for (int i = 0; i < tournamentCount; i++)
        {
            if (tournamentID == tournamentIDs[i])
            {
                duplicate = true;
                break;
            }
        }


        if (duplicate)
        {
            cout << "Tournament ID already exists!" << endl;
            continue;
        }


        break;
    }


    tournamentIDs[tournamentCount] = tournamentID;


    // Game
    string game_name;
    int game_choice;


    while (true)
    {
        cout << "\nPlease select a game:" << endl;
        cout << "1. Valorant" << endl;
        cout << "2. Mobile Legends" << endl;
        cout << "3. PUBG" << endl;
        cout << "4. EA FC" << endl;

        cout << "Please enter your game choice (1-4): ";
        cin >> game_choice;


        switch (game_choice)
        {
        case 1:
            game_name = "Valorant";
            break;

        case 2:
            game_name = "Mobile Legends";
            break;

        case 3:
            game_name = "PUBG";
            break;

        case 4:
            game_name = "EA FC";
            break;

        default:
            cout << "Invalid choice!" << endl;
            continue;
        }


        break;
    }


    gameNames[tournamentCount] = game_name;


    // Date
    int day;
    int month;
    int year;


    while (true)
    {
        cout << "\nEnter the day (1-31): ";
        cin >> day;


        if (day < 1 || day > 31)
        {
            cout << "Invalid day!" << endl;
            continue;
        }

        break;
    }


    while (true)
    {
        cout << "Enter the month (1-12): ";
        cin >> month;


        if (month < 1 || month > 12)
        {
            cout << "Invalid month!" << endl;
            continue;
        }

        break;
    }


    while (true)
    {
        cout << "Enter the year (2026 or 2027): ";
        cin >> year;


        if (year != 2026 && year != 2027)
        {
            cout << "Invalid year!" << endl;
            continue;
        }

        break;
    }


    days[tournamentCount] = day;
    months[tournamentCount] = month;
    years[tournamentCount] = year;


    tournamentCount++;


    cout << "\nAdd tournament successful!" << endl;
}


